{
  "workbench.colorTheme": "Catppuccin Mocha",
  "catppuccin.accentColor": "sapphire",
  "catppuccin.workbenchMode": "default",
  "catppuccin.italicComments": true,
  "catppuccin.italicKeywords": true,
  "catppuccin.boldKeywords": true,
  "catppuccin.bracketMode": "rainbow",

  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "editor.fontSize": 11,
  "editor.cursorStyle": "line",
  "editor.cursorBlinking": "smooth",
  "editor.renderLineHighlight": "line",
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "boundary",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
  "terminal.integrated.fontSize": 11,
  "terminal.integrated.cursorStyle": "beam",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.defaultProfile": "Linux",
  "terminal.integrated.gpuAcceleration": "off",
  "terminal.integrated.background": "#1e1e2e",
  "terminal.integrated.foreground": "#cdd6f4",
  "terminal.integrated.selectionBackground": "#585b70",
  "terminal.integrated.cursorForeground": "#74c7ec",
  "terminal.integrated.ansiBlack": "#45475a",
  "terminal.integrated.ansiRed": "#f38ba8",
  "terminal.integrated.ansiGreen": "#a6e3a1",
  "terminal.integrated.ansiYellow": "#f9e2af",
  "terminal.integrated.ansiBlue": "#89b4fa",
  "terminal.integrated.ansiMagenta": "#f5c2e7",
  "terminal.integrated.ansiCyan": "#94e2d5",
  "terminal.integrated.ansiWhite": "#bac2de",
  "terminal.integrated.ansiBrightBlack": "#585b70",
  "terminal.integrated.ansiBrightRed": "#f38ba8",
  "terminal.integrated.ansiBrightGreen": "#a6e3a1",
  "terminal.integrated.ansiBrightYellow": "#f9e2af",
  "terminal.integrated.ansiBrightBlue": "#89b4fa",
  "terminal.integrated.ansiBrightMagenta": "#f5c2e7",
  "terminal.integrated.ansiBrightCyan": "#94e2d5",
  "terminal.integrated.ansiBrightWhite": "#a6adc8",

  "security.workspace.trust.enabled": true,
  "telemetry.telemetryLevel": "off"
}
