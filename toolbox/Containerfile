# syntax=docker/dockerfile:1
ARG FEDORA_RELEASE=44

FROM registry.fedoraproject.org/fedora:${FEDORA_RELEASE} AS go-builder
ARG DEJA_VERSION=v0.4.2
ARG LAZYGIT_VERSION=v0.65.1
USER root
RUN dnf -y install --setopt=install_weak_deps=False golang git ca-certificates gcc glibc-devel \
    && mkdir -p /out \
    && GOBIN=/out CGO_ENABLED=1 go install -trimpath -ldflags='-s -w' github.com/Giammarco-Ferranti/deja/cmd/deja@${DEJA_VERSION} \
    && GOBIN=/out CGO_ENABLED=0 go install -trimpath -ldflags='-s -w' github.com/jesseduffield/lazygit@${LAZYGIT_VERSION} \
    && /out/deja --version \
    && /out/lazygit --version

FROM registry.fedoraproject.org/fedora:${FEDORA_RELEASE} AS rust-builder
ARG EZA_VERSION=0.23.5
ARG STARSHIP_VERSION=1.26.0
ARG YAZI_VERSION=26.9.1
USER root
RUN dnf -y install --setopt=install_weak_deps=False \
       rust cargo gcc gcc-c++ make cmake perl pkgconf-pkg-config openssl-devel \
    && mkdir -p /out \
    && cargo install --locked --root /out --git https://github.com/eza-community/eza --tag "v${EZA_VERSION}" eza \
    && cargo install --locked --root /out --git https://github.com/starship/starship --tag "v${STARSHIP_VERSION}" starship \
    && cargo install --locked --root /out --git https://github.com/sxyazi/yazi --tag "v${YAZI_VERSION}" yazi-fm \
    && cargo install --locked --root /out --git https://github.com/sxyazi/yazi --tag "v${YAZI_VERSION}" yazi-cli \
    && /out/bin/eza --version \
    && /out/bin/starship --version \
    && /out/bin/yazi --version \
    && /out/bin/ya --version

FROM registry.fedoraproject.org/fedora-toolbox:${FEDORA_RELEASE}
ARG FEDORA_RELEASE=44
ARG DEJA_VERSION=v0.4.2
ARG LAZYGIT_VERSION=v0.65.1
ARG EZA_VERSION=0.23.5
ARG STARSHIP_VERSION=1.26.0
ARG YAZI_VERSION=26.9.1
ARG ZINIT_VERSION=v3.17.0
ARG ZINIT_COMMIT=db9e267184c85a26056c2646222f48df609cecd5
ARG ZSH_SYNTAX_HIGHLIGHTING_VERSION=0.8.0
ARG ZSH_SYNTAX_HIGHLIGHTING_COMMIT=db085e4661f6aafd24e5acb5b2e17e4dd5dddf3e
ARG MISE_VERSION=v2026.9.14

LABEL org.opencontainers.image.title="biomlds Fedora workstation Toolbx" \
      org.opencontainers.image.description="Versioned CLI environment for Fedora Sway Atomic" \
      org.opencontainers.image.source="https://github.com/biomlds/fedora-sway-atomic-workstation" \
      org.opencontainers.image.licenses="MIT" \
      io.containers.toolbox="true" \
      com.github.containers.toolbox="true"

USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN dnf -y upgrade --refresh \
    && dnf -y install --setopt=install_weak_deps=False \
       zsh git git-lfs curl wget ca-certificates openssh-clients \
       fzf bat ripgrep fd-find neovim tmux jq tree file sqlite-libs \
       unzip zip 7zip tar gzip bzip2 xz \
       make gcc gcc-c++ pkgconf-pkg-config python3 python3-pip nodejs npm \
       ShellCheck shfmt man-db man-pages procps-ng which util-linux \
       ImageMagick poppler-utils ffmpeg-free \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# mise's official installer is pinned to a release and installs only the requested binary.
RUN curl -fsSL --retry 3 https://mise.run -o /tmp/mise-install.sh \
    && MISE_INSTALL_PATH=/usr/local/bin/mise MISE_VERSION=${MISE_VERSION} sh /tmp/mise-install.sh \
    && rm -f /tmp/mise-install.sh \
    && mise --version

# Pinned by commit rather than tag: a tag can be moved to point at new content.
RUN git init -q /usr/local/share/zinit \
    && cd /usr/local/share/zinit \
    && git remote add origin https://github.com/zdharma-continuum/zinit.git \
    && git fetch --depth 1 --quiet origin "${ZINIT_COMMIT}" \
    && git checkout -q FETCH_HEAD \
    && rm -rf /usr/local/share/zinit/.git \
    && git init -q /usr/local/share/zsh-syntax-highlighting \
    && cd /usr/local/share/zsh-syntax-highlighting \
    && git remote add origin https://github.com/zsh-users/zsh-syntax-highlighting.git \
    && git fetch --depth 1 --quiet origin "${ZSH_SYNTAX_HIGHLIGHTING_COMMIT}" \
    && git checkout -q FETCH_HEAD \
    && rm -rf /usr/local/share/zsh-syntax-highlighting/.git \
    && chmod -R a+rX /usr/local/share/zinit /usr/local/share/zsh-syntax-highlighting \
    && test -s /usr/local/share/zinit/zinit.zsh \
    && test -s /usr/local/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

COPY --from=go-builder /out/deja /usr/local/bin/deja
COPY --from=go-builder /out/lazygit /usr/local/bin/lazygit
COPY --from=rust-builder /out/bin/eza /usr/local/bin/eza
COPY --from=rust-builder /out/bin/starship /usr/local/bin/starship
COPY --from=rust-builder /out/bin/yazi /usr/local/bin/yazi
COPY --from=rust-builder /out/bin/ya /usr/local/bin/ya
RUN chmod 0755 /usr/local/bin/deja /usr/local/bin/lazygit /usr/local/bin/eza /usr/local/bin/starship /usr/local/bin/yazi /usr/local/bin/ya \
    && for command in zsh git fzf eza bat rg nvim lazygit tmux yazi ya starship mise jq tree deja; do command -v "$command" >/dev/null; done \
    && test -r /usr/local/share/zinit/zinit.zsh \
    && test -r /usr/local/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

ENV SHELL=/usr/bin/zsh \
    EDITOR=nvim \
    VISUAL=nvim
