# Exclusions for the home directory managed as a yadm repository.
# This file must stay byte-equivalent with .config/yadm/skip; validate-repo.sh
# fails if the two diverge, because yadm reads one and a plain checkout of this
# repository reads the other.

.DS_Store
*.swp
*.swo
*.tmp
*.log
.validation/
result/

# Flatpak application state. The config subdirectory is intentionally not
# excluded here: VS Code's settings.json is tracked under it.
.var/app/*/cache/
.var/app/*/data/
.var/app/*/.removed

# VS Code writes caches and per-workspace state next to settings.json. The
# settings file itself must stay tracked, so each volatile sibling is listed
# rather than excluding the parent directory.
.var/app/com.visualstudio.code/config/Code/Backups/
.var/app/com.visualstudio.code/config/Code/CachedData/
.var/app/com.visualstudio.code/config/Code/CachedExtensions/
.var/app/com.visualstudio.code/config/Code/Cache/
.var/app/com.visualstudio.code/config/Code/Code Cache/
.var/app/com.visualstudio.code/config/Code/DawnCache/
.var/app/com.visualstudio.code/config/Code/GPUCache/
.var/app/com.visualstudio.code/config/Code/logs/
.var/app/com.visualstudio.code/config/Code/Service Worker/
.var/app/com.visualstudio.code/config/Code/User/globalStorage/
.var/app/com.visualstudio.code/config/Code/User/workspaceStorage/
.var/app/com.visualstudio.code/config/Code/User/History/

# Flatpak regenerates autostart desktop files into the config directory.
.var/app/*/config/autostart/

# Editor and shell noise that is machine state rather than configuration.
.config/nvim/shada/
.config/zsh/zcompdump*
.local/state/zsh/
