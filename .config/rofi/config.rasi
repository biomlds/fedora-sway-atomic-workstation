configuration {
  modi: "drun,run,window";
  show-icons: true;
  display-drun: "Apps";
  display-run: "Run";
  display-window: "Windows";
  drun-display-format: "{name}";
  font: "JetBrainsMono Nerd Font 12";
  icon-theme: "Adwaita";
  terminal: "foot";
  matching: "fuzzy";
  sorting-method: "fzf";
  sort: true;
}

@theme "catppuccin-mocha-sapphire"
